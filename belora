#!/usr/bin/env -S bash --norc --noprofile

#    ___      __             
#   / _ )___ / /__  _______ _
#  / _  / -_) / _ \/ __/ _ `/
# /____/\__/_/\___/_/  \_,_/ 

readonly BELORA_SERVER="/var/tmp/belora" # Path to the Belora's tmux server
readonly -a BELORA_NAMES=(               # List of names that are used for selecting the names of the Belora sessions
    "Tracer"
    "Reaper"
    "Widowmaker"
    "Pharah"
    "Reinhardt"
    "Mercy"
    "Torbjörn"
    "Hanzo"
    "Winston"
    "Zenyatta"
    "Bastion"
    "Symmetra"
    "Zarya"
    "McCree"
    "Soldier"
    "Lúcio"
    "Roadhog"
    "Junkrat"
    "D.Va"
    "Mei"
    "Genji"
    "scout"
)

# Do nothing if already inside TMUX session
if ! [[ -z "${TMUX+x}" ]] || ! [[ -z "${SESSION+x}" ]]; then
    if [[ "${#}" -gt 0 ]]; then
        exec "${@}"
    else
        exit 1
    fi
fi

mapfile -t session_names < <( shuf -e "${BELORA_NAMES[@]}" )
mapfile -t sessions < <( tmux -S "${BELORA_SERVER}" list-sessions || printf "" )

#  If no argument ware passed
if [[ "${#}" -lt 1 ]]; then
    for session in "${sessions[@]}"; do
        if [[ ! "$session" =~ "attached" ]]; then
            exec tmux -S "${BELORA_SERVER}" attach-session -t "${session/:*/}"
        fi
    done
fi

# If all session names are used up
if [[ "${#sessions[@]}" -ge "${#BELORA_NAMES[@]}" ]]; then
    exec tmux -S "${BELORA_SERVER}" new-session -s "${RANDOM}" "${@}"
fi

# Pick random name and create new session
for name in "${session_names[@]}"; do
    if ! [[ "${sessions[*]}" =~ "${name}" ]]; then
        exec tmux -S "${BELORA_SERVER}" new-session -s "${name}" "${@}"
    fi
done

