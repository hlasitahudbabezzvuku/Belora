#!/usr/bin/env -S bash --norc --noprofile

#    ___      __             
#   / _ )___ / /__  _______ _
#  / _  / -_) / _ \/ __/ _ `/
# /____/\__/_/\___/_/  \_,_/ 

declare -a BELORA_NAMES=(
    "D.Va"
    "Doomfist"
    "Reinhardt"
    "Roadhog"
    "Winston"
    "Zarya"
    "Bastion"
    "McCree"
    "Echo"
    "Genji"
    "Hanzo"
    "Junkrat"
    "Mei"
    "Pharah"
    "Reaper"
    "Sojourn"
    "Soldier"
    "Sombra"
    "Symmetra"
    "Torbjörn"
    "Tracer"
    "Ana"
    "Brigitte"
    "Lúcio"
    "Mercy"
    "Moira"
    "Zenyatta"
)

declare BELORA_SERVER="/var/tmp/belora"

if [[ -n "${TMUX+x}" ]]; then
    exec "${@}"
fi

mapfile -t sessions < <( tmux -S "${BELORA_SERVER}" list-sessions )

if [[ -z "${1}" ]]; then
    for session in "${sessions[@]}"; do
        if [[ ! "$session" =~ "attached" ]]; then
            exec tmux -S "${BELORA_SERVER}" attach-session -t "${session/:*/}"
        fi
    done
fi

if [[ "${#sessions[@]}" -ge "${#BELORA_NAMES[@]}" ]]; then
    exit 1
fi

name="${BELORA_NAMES[RANDOM % ${#BELORA_NAMES[@]}]}"

while [[ "${sessions[*]}" =~ "${name}" ]]; do
    name="${BELORA_NAMES[RANDOM % ${#BELORA_NAMES[@]}]}"
done

exec tmux -S "${BELORA_SERVER}" new-session -s "${name}" "${@}"
